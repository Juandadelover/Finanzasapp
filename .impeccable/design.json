  "narrative": {
    "northStar": "The Pocket Ledger",
    "overview": "A ledger you can read with one thumb at the counter. The surface is quiet, tonal and dark by default; one violet brand gradient marks the two things that matter most, the balance and the act of adding a movement. Everything else is stepped neutral surfaces, soft rounded forms and green/red money semantics.",
    "keyCharacteristics": [
      "Dark theme is the default; light theme is a full mirror via CSS variables and a .dark class.",
      "Tonal layering (bg, surface, surface-2, surface-3) carries depth; borders are 1px hairlines.",
      "One accent: the violet gradient. Green and red mean money in and out only.",
      "Generous rounding (12 to 24px) and pill shapes for navigation and chips.",
      "Lucide line icons in tinted rounded-square wells."
    ],
    "rules": [
      {"name": "The Money Semantics Rule", "body": "Green and red appear only for money direction and error state, never as decoration.", "section": "colors"},
      {"name": "The Gradient Is Earned Rule", "body": "The brand gradient fills only the hero balance card, primary submit buttons, the FAB and the logo tile.", "section": "colors"},
      {"name": "The Amount First Rule", "body": "The largest, boldest text on a screen is a money figure, colored by direction where it is a movement.", "section": "typography"},
      {"name": "The Flat Cards Rule", "body": "Content cards never get a shadow; only brand-gradient and floating elements do.", "section": "elevation"}
    ],
    "dos": [
      "Do read colors from the CSS variables (var(--color-*)) so both themes work.",
      "Do keep touch targets at 44px or larger and give icon-only controls an aria-label.",
      "Do mask amounts with MASKED_AMOUNT when privacy mode is on.",
      "Do use text-sm for body and text-xs for metadata; reserve bold large type for amounts and page titles.",
      "Do reuse existing radii (12, 16, 24, full) rather than adding new steps."
    ],
    "donts": [
      "Don't use the brand gradient on content cards, tiles or decorative fills.",
      "Don't use green or red for anything other than income/expense semantics and errors.",
      "Don't add shadows to ordinary content cards.",
      "Don't hard-code hex colors for UI chrome; category colors are user data and the only exception."
    ]
  }
